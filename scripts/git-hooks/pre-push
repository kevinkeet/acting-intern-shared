#!/usr/bin/env bash
# Pre-push guard for actingintern.com (guardrails, 21 Oct 2026). Only pushes to main are
# checked, because a push to main deploys the live site while the TEACH-AI study is running.
# Install once per clone (all worktrees share it): sh scripts/install-git-hooks.sh
# What it checks and how to override: scripts/predeploy-check.mjs and CLAUDE.md, "Study guardrails".
remote="$1"
zero=0000000000000000000000000000000000000000
top="$(git rev-parse --show-toplevel)"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$remote_ref" = "refs/heads/main" ] || continue
    [ "$local_sha" = "$zero" ] && continue
    if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        base="$remote_sha"
    else
        base="$(git merge-base "$local_sha" "refs/remotes/$remote/main" 2>/dev/null || git merge-base "$local_sha" refs/remotes/origin/main 2>/dev/null)"
    fi
    if [ -z "$base" ]; then
        echo "pre-push: cannot tell what $remote/main already has. Run git fetch $remote, then push again."
        exit 1
    fi
    echo "pre-push: checking what is about to go live on $remote/main"
    node "$top/scripts/predeploy-check.mjs" "$base" "$local_sha" < /dev/null || status=1
done
exit $status
